API_KEY=change-me
CLUSTER_KEY=change-cluster-key
COMFY_URL=http://127.0.0.1:8188
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
# Set only when an authenticated platform proxy exposes the WebUI.
COMFY_PUBLIC_URL=
# Optional portable path overrides; scripts derive writable defaults from the checkout.
# DATA_DIR=/mnt/workspace/soup-comfy-data
# COMFY_DIR=/mnt/workspace/soup-comfy-data/ComfyUI
# VENV_DIR=/mnt/workspace/soup-comfy-data/venv
# Standalone CLIs are persisted here; defaults to DATA_DIR/tools, then user/project storage.
# TOOLS_HOME=/mnt/workspace/soup-comfy-data/tools
# TOOLS_BIN_DIR=/mnt/workspace/soup-comfy-data/tools/bin
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_PUBLIC_URL=
# Remote-managed Cloudflare Tunnel. No image-baked CLI or root access is required.
INSTALL_CLOUDFLARED=1
ENABLE_CLOUDFLARED=0
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_URL=
# Optional alternate binary download URL for restricted GitHub networks.
CLOUDFLARED_DOWNLOAD_URL=
INSTALL_POSE_GALLERY=0
# Optional debug UI; the REST API does not require Gradio.
INSTALL_GRADIO_UI=0
ENABLE_GRADIO_UI=0
# Optional ComfyUI Web template gallery; not required by local/API workflows.
INSTALL_COMFY_WORKFLOW_TEMPLATES=0
# Soup is optional. For Docker, build with INSTALL_SOUP=1 and run with ENABLE_SOUP=1.
INSTALL_SOUP=0
ENABLE_SOUP=0
MODEL_SCOPE_TOKEN=
# all | image | video | custom
MODEL_PROFILE=all
# Optional overrides for video/custom downloads.
# WAN_REPO=Comfy-Org/Wan_2.1_ComfyUI_repackaged
# WAN_MODEL=split_files/diffusion_models/wan2.1_i2v_720p_14B_fp8_e4m3fn.safetensors
# MODEL_ID=organization/repository
# MODEL_FILE=path/to/model.safetensors
# MODEL_DIR=diffusion_models
# MODEL_REVISION=
# auto: use Tsinghua for mainland-China timezones, otherwise official PyPI.
# You can force tsinghua, aliyun, or pypi. An explicit PIP_MIRROR overrides PIP_INDEX_URL.
PIP_MIRROR=auto
# Optional fully custom index. In auto mode, an existing value takes precedence.
PIP_INDEX_URL=
# auto reuses preinstalled PyTorch/CUDA when the base image provides them.
# Changing PIP_MIRROR/PIP_INDEX_URL does not rebuild this persistent environment.
# Set 0 for a fully isolated venv (Docker build default when torch is absent).
# PYTHON_BIN=/opt/conda/bin/python
# VENV_REBUILD=0  # set to 1 only for an explicit one-time rebuild
VENV_USE_SYSTEM_SITE_PACKAGES=auto
# ModelScope is needed only by make models; keep its package source independent.
MODELSCOPE_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# auto/direct use github.com. Only set a prefix when it supports Git Smart HTTP.
# File-only proxies such as ghfast.top are not valid git clone remotes.
GITHUB_MIRROR_PREFIX=auto
# Unified persistent caches and Bash/zsh environment; normally derived from DATA_DIR.
# CACHE_DIR=/mnt/workspace/soup-comfy-data/cache
# PIP_CACHE_DIR=/mnt/workspace/soup-comfy-data/cache/pip
# SHELL_HOME=/mnt/workspace/soup-comfy-data/shell
SHELL_KIND=zsh
# Shell initialization is independent of the project venv.
INSTALL_OMZ=1
OMZ_THEME=clean
# Package manager settings are written under SHELL_HOME, never into the host account.
NPM_REGISTRY=https://registry.npmjs.org/
REQUIRE_CLUSTER_KEY=false
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
COMFY_STARTUP_TIMEOUT=180
GATEWAY_STARTUP_TIMEOUT=60
DEFAULT_VIDEO_WIDTH=720
DEFAULT_VIDEO_HEIGHT=1280
DEFAULT_VIDEO_FRAMES=81
DEFAULT_VIDEO_FPS=16
COMFY_TIMEOUT_SECONDS=3600
MAX_UPLOAD_MB=40
