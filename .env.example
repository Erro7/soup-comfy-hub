API_KEY=change-me
CLUSTER_KEY=change-cluster-key
COMFY_URL=http://127.0.0.1:8188
# Optional portable path overrides; scripts derive defaults from the checkout.
# DATA_DIR=/mnt/workspace/soup-comfy-data
# COMFY_DIR=/mnt/workspace/soup-comfy-data/ComfyUI
# VENV_DIR=/mnt/workspace/soup-comfy-data/venv
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_PUBLIC_URL=
CLOUDFLARE_TUNNEL_TOKEN=
ENABLE_CLOUDFLARED=0
INSTALL_POSE_GALLERY=0
# Optional debug UI; the REST API does not require Gradio.
INSTALL_GRADIO_UI=0
ENABLE_GRADIO_UI=0
# Soup is optional. For Docker, build with INSTALL_SOUP=1 and run with ENABLE_SOUP=1.
INSTALL_SOUP=0
ENABLE_SOUP=0
MODEL_SCOPE_TOKEN=
# auto: use Tsinghua for mainland-China timezones, otherwise official PyPI.
# You can force tsinghua, aliyun, or pypi. An explicit PIP_MIRROR overrides PIP_INDEX_URL.
PIP_MIRROR=auto
# Optional fully custom index. In auto mode, an existing value takes precedence.
PIP_INDEX_URL=
# ModelScope is needed only by make models; keep its package source independent.
MODELSCOPE_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# auto/direct use github.com. Only set a prefix when it supports Git Smart HTTP.
# File-only proxies such as ghfast.top are not valid git clone remotes.
GITHUB_MIRROR_PREFIX=auto
# Persistent wheel cache; normally derived from DATA_DIR.
# PIP_CACHE_DIR=/mnt/workspace/soup-comfy-data/pip-cache
# SHELL_HOME=/mnt/workspace/soup-comfy-data/shell
OMZ_THEME=robbyrussell
REQUIRE_CLUSTER_KEY=false
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
COMFY_STARTUP_TIMEOUT=180
DEFAULT_VIDEO_WIDTH=720
DEFAULT_VIDEO_HEIGHT=1280
DEFAULT_VIDEO_FRAMES=81
DEFAULT_VIDEO_FPS=16
COMFY_TIMEOUT_SECONDS=3600
MAX_UPLOAD_MB=40
