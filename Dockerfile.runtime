FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PROJECT_DIR=/app DATA_DIR=/data COMFY_DIR=/data/ComfyUI VENV_DIR=/data/venv \
    GATEWAY_HOST=0.0.0.0 GATEWAY_PORT=8000
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ffmpeg git curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
EXPOSE 8000
VOLUME ["/data"]
ENTRYPOINT ["bash", "scripts/container_entrypoint.sh"]
